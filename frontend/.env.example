# Base URL for API calls.
#
# Leave this unset to use the Vite dev proxy: requests go to /api on the same
# origin and are forwarded to the backend, which avoids CORS entirely. Set it
# to an absolute URL (e.g. http://localhost:8000/api) when the frontend is
# served from a different origin than the backend.
#
# The streaming endpoint uses fetch rather than EventSource because the request
# is a POST with a JSON body, which EventSource cannot send.
VITE_API_URL=
