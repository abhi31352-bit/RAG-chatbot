# Application
APP_NAME="RAG Chatbot"
APP_ENV=development
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# OpenAI
# Any key containing "your-key", or starting with "sk-your", counts as unset
# and the app stays on the offline responder. That is deliberate: a copied
# template should not produce auth errors.
OPENAI_API_KEY=sk-your-key-here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Endpoint for the embedding client. Blank = api.openai.com. Set it for any
# OpenAI-compatible gateway or self-hosted server; without it, an embedding
# model name that OpenAI does not publish cannot be reached.
OPENAI_BASE_URL=

# Groq -- chat completions only, and independent of the embedding provider.
# Groq serves an OpenAI-compatible API, so no extra dependency is needed. It
# is inference-only, so configuring a key here changes what writes the answers
# and cannot invalidate the vector store. GROQ_BASE_URL already points at the
# right endpoint, so the key alone is enough.
GROQ_API_KEY=gsk-your-key-here
GROQ_BASE_URL=https://api.groq.com/openai/v1

# The model that writes the answers. Must be a name your endpoint serves; an
# unknown one returns 404 model_not_found, reported as LLM_UNAVAILABLE.
# List what your key can reach with:
#   curl $GROQ_BASE_URL/models -H "Authorization: Bearer $GROQ_API_KEY"
# Model names get retired by providers, so this drifts. "llama-3.1-8b-instant"
# was the original choice here and now 404s on every Groq account; the text
# models currently served include openai/gpt-oss-120b (the default here),
# openai/gpt-oss-20b, and qwen/qwen3.8-27b.
LLM_MODEL=openai/gpt-oss-120b

# Embeddings
# auto  -> use OpenAI when OPENAI_API_KEY is a real key, otherwise fall back
#          to the built-in local embedder so the demo still works offline
# openai -> force OpenAI (startup error if the key is missing/placeholder)
# local  -> force the local embedder (no API key, no torch download)
#
# Leave this `local` unless you intend to re-upload every document. Switching
# to `openai` changes the vector width (2048 -> 1536) and every query then
# fails with 409 EMBEDDING_MISMATCH until the index is rebuilt.
EMBEDDING_PROVIDER=local
# Must match the width of the stored index. 512 is not safe: two terms
# colliding in one bucket can cancel exactly, which makes a word present in
# the document unretrievable. See architecture.md 4.4.
LOCAL_EMBEDDING_DIM=2048
EMBEDDING_BATCH_SIZE=100
EMBEDDING_CACHE_SIZE=2048

# Vector Store
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_NAME=course_documents
# Where uploaded files are kept. These three paths anchor to backend/, not to
# the current directory, so they resolve the same however the server starts.
UPLOAD_DIR=./data/uploads

# Database
DATABASE_URL=sqlite:///./data/app.db
# Log every SQL statement. Noisy; leave off unless debugging.
SQL_ECHO=false

# Document Processing
MAX_FILE_SIZE_MB=50
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K_RETRIEVAL=5
# Cosine distance above which a retrieved chunk is treated as irrelevant.
MAX_RETRIEVAL_DISTANCE=1.0

# LLM Settings
# groq    -> require GROQ_API_KEY (startup error if missing/placeholder)
# openai  -> require OPENAI_API_KEY (same)
# auto    -> whichever usable key is configured, preferring Groq; offline if
#            neither is set
# offline -> always use the extractive responder, never call out
#
# An explicit value is what you want when demoing: it fails loudly on a bad
# key instead of quietly degrading to the offline responder. "auto" is what
# makes the demo work with no credentials at all.
#
# The offline responder is not a language model. It quotes the retrieved
# sentences that best match the question and cites them. Every API response
# reports which one ran in its "mode" field: "groq", "openai", or
# "offline-extractive".
LLM_PROVIDER=auto
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=30
# Prior turns fed back to the model (user+assistant pairs).
MAX_HISTORY_MESSAGES=10
# Characters of a retrieved chunk shown as a source excerpt.
SOURCE_EXCERPT_CHARS=200
# Sentences the offline responder will quote back.
OFFLINE_MAX_SENTENCES=4
# Minimum lexical overlap for an offline-extracted sentence to be included.
OFFLINE_MIN_SIMILARITY=0.02

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60
